{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "egybook-reels-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "REELS_BUCKET",
      "bucket_name": "egybook-reels"
    }
  ]
}